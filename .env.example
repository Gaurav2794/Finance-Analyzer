# ─────────────────────────────────────────────────────────────────────────────
# Finance Analyzer — Environment Configuration Template
# Copy this file to .env and provide your deployment secrets.
# DO NOT commit real secrets to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── Database (SQLite for dev, PostgreSQL for production) ──────────────────────
# Development:
DATABASE_URL=sqlite:///./finance_analyzer.db
# Production (Render / Neon / AWS RDS):
# DATABASE_URL=postgresql://user:password@hostname:5432/finance_analyzer_db

# ── JWT Authentication Secret ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_32_byte_secret_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google Gemini API (Server-Side Grounded AI Assistant) ─────────────────────
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── CORS & Frontend Integration ───────────────────────────────────────────────
# In production, set to your deployed frontend domain(s) (comma-separated):
FRONTEND_URL=https://your-frontend.vercel.app,https://your-frontend.onrender.com
# Development defaults:
# FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ── Persistent Storage Paths (Optional / Production Disks) ────────────────────
# UPLOAD_DIR=/var/data/uploads
# OUTPUT_DIR=/var/data/outputs
